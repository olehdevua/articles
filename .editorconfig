# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

indent_style = space
indent_size = 2
tab_width = 4

max_line_length = 80

[*.ts]
max_line_length = 90

[*.json]
max_line_length = 90

[*.md]
max_line_length = 90
tab_width = 2
